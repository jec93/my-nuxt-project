datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  loginId   String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model Menu {
  screenKey String  @id
  parentKey String?
  label     String

  // 선택
  url       String?
  domain    String?

  // 운영/정렬
  depth     Int
  order     Int
  isActive  Boolean @default(true)

  // 관계
  parent   Menu?  @relation("MenuTree", fields: [parentKey], references: [screenKey], onDelete: SetNull)
  children Menu[] @relation("MenuTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentKey, order])
  @@index([depth])
}

model WorkItem {
  id        BigInt   @id @default(autoincrement())
  domain    String   @db.VarChar(80) // menu의 domain과 매칭
  title     String   @db.VarChar(200)
  status    String   @db.VarChar(20) // 대기/진행/완료
  owner     String?  @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain])
  @@index([status])
  @@index([createdAt])
}

model Favorite {
  id        BigInt   @id @default(autoincrement())
  userId    String   @db.VarChar(50)   // 너 프로젝트의 user PK 타입에 맞춰 (예: user_no, id 등)
  menuKey   String   @db.VarChar(80)   // menu.screenKey 저장
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, menuKey])
  @@index([userId])
}

model ShareInbox {
  id         Int      @id @default(autoincrement())
  fromUserId String
  toUserId   String
  menuKey    String
  domain     String
  message    String?
  status     String   @default("NEW") // NEW | READ | DISMISSED
  createdAt  DateTime @default(now())
  readAt     DateTime?

  @@index([toUserId, status, createdAt])
  @@index([menuKey])
}

model UserPermission {
  id        Int      @id @default(autoincrement())
  userId    String
  domain    String
  grantedBy String?  // ADMIN userId
  createdAt DateTime @default(now())

  @@unique([userId, domain])
  @@index([domain])
  @@index([userId])
}

model PermissionRequest {
  id          Int      @id @default(autoincrement())
  userId      String
  domain      String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedAt DateTime @default(now())
  decidedAt   DateTime?
  decidedBy   String?  // ADMIN userId
  reason      String?

  @@index([status, requestedAt])
  @@index([userId, domain])
  @@unique([userId, domain, status])
}
